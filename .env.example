# Archil credentials for the `disk` CLI and the `disk` Node library.
#
# Copy this file to `.env` (which is gitignored) and fill in your real values.
# Never commit the real `.env`, and never paste the key into a chat transcript.
#
# Get an API key: https://console.archil.com/?utm_source=freebuff&utm_medium=paid&utm_campaign=archil
ARCHIL_API_KEY=key-...

# Pick the region closest to where your compute runs.
# Regions supporting serverless exec: aws-us-east-1, aws-us-west-2, aws-eu-west-1
ARCHIL_REGION=aws-us-east-1
